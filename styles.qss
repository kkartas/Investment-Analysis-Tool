/* styles.qss - modern styling */
QMainWindow {
    background-color: #ffffff;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #d3d3d3;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
}

QPushButton {
    background-color: #0078d7;
    color: white;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #005a9e;
}

QLineEdit, QDateEdit, QSpinBox, QComboBox, QTextEdit {
    padding: 4px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

@media (max-width: 600px) {
    QMainWindow {
        font-size: 10pt;
    }
    QPushButton {
        padding: 4px 8px;
    }
}
